<!DOCTYPE html>
<html lang="en-US">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Officina Marlo — artist-run studio and project space, Lincoln, Nebraska</title>
<meta name="description" content="Officina Marlo is an artist-run studio and curatorial project space in the Havelock neighborhood of Lincoln, Nebraska. Studio by invitation; public programs in the window and around Lincoln. Opening soon.">
<meta name="theme-color" content="#ffffff">
<meta name="color-scheme" content="light">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='15' fill='%23002FA7'/%3E%3Ccircle cx='16' cy='16' r='3.6' fill='%23ffffff'/%3E%3C/svg%3E">
<style>
  @font-face {
    font-family: "Jost";
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url(data:font/woff2;base64,) format("woff2");
  }
  :root {
    --ink: #111111;
    --blue: #002A96;
    --red: #FF4B1F;
    --paper: #ffffff;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: "Jost", "Futura", "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 19px;
    font-weight: 450;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 56px);
  }
  .modules { display: block; width: 100%; height: auto; margin-top: clamp(20px, 4vw, 44px); }
  header { padding: clamp(36px, 7vw, 88px) 0 clamp(32px, 5vw, 56px); }
  h1 { margin: 0; line-height: 0; }
  .wordmark { display: block; width: 100%; height: auto; color: var(--ink); }
  .hero { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; margin-top: clamp(28px, 4.5vw, 52px); }
  .hero .descriptor { margin: 0; }
  .facade { margin: 0; }
  .facade img { display: block; width: 100%; aspect-ratio: 1.5; object-fit: cover; object-position: 50% 40%; height: auto; }
  .band { display: block; width: 100%; height: auto; margin: clamp(40px, 6vw, 72px) 0 clamp(32px, 5vw, 56px); }
  .facade figcaption { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; margin-top: 10px; }
  .descriptor {
    margin: clamp(24px, 3.5vw, 40px) 0 0;
    color: var(--blue);
    font-size: clamp(21px, 2.6vw, 30px);
    line-height: 1.25;
    max-width: 22ch;
  }
  .band-top { margin: clamp(24px, 4vw, 44px) 0 0; }
    .feature { display: grid; grid-template-columns: clamp(100px, 14vw, 150px) minmax(0, 1fr); align-items: stretch; }
  .panel { background: var(--blue); color: #fff; padding: clamp(24px, 3vw, 40px); display: flex; flex-direction: column; justify-content: space-between; gap: 28px; }
  .panel p { max-width: 30em; }
  .panel .lead { margin-bottom: 0; }
  .panel .name-note { margin-bottom: 0; }
  .tiles-v { display: block; width: 100%; height: auto; align-self: start; }
  .tiles-h { display: none; width: 100%; height: auto; }
  .row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    column-gap: 32px;
    padding: 28px 0 40px;
    border-top: 2px solid var(--ink);
  }
  .label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding-top: 7px;
  }
  .body p { margin: 0 0 1.1em; max-width: 34em; }
  .body p:last-child { margin-bottom: 0; }
  .lead { font-size: clamp(22px, 2.4vw, 27px); line-height: 1.38; }
  .name-note { line-height: 1.6; }
  .name-note em { font-style: normal; font-weight: 600; letter-spacing: 0.04em; }
  address { font-style: normal; font-size: clamp(22px, 2.4vw, 27px); line-height: 1.38; }
  .body .access { margin: 20px 0 0; max-width: 30em; }
  .soon {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 22px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 14px;
  }
  .soon::before {
    content: "";
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--red);
  }
  a {
    color: var(--blue);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  a:hover, a:focus-visible { color: var(--ink); text-decoration-color: var(--red); text-decoration-thickness: 4px; }
  a:focus-visible { outline: 3px solid var(--red); outline-offset: 3px; }
  .contact a { font-size: clamp(22px, 2.4vw, 27px); }
  .contact .events { margin: 22px 0 0; font-size: 17px; }
  .contact .events a { font-size: inherit; }
  footer {
    border-top: 2px solid var(--ink);
    padding: 20px 0 52px;
    font-size: 14px;
    letter-spacing: 0.04em;
  }
  @media (max-width: 720px) {
    .hero { grid-template-columns: 1fr; gap: 20px; }
    .feature { grid-template-columns: 1fr; }
    .tiles-v { display: none; }
    .tiles-h { display: block; margin-top: 0; }
    body { font-size: 18px; }
    .row { grid-template-columns: 1fr; row-gap: 12px; }
    .label { padding-top: 0; }
  }
</style>
